{
    "compilerOptions": {
        "target": "es6",
        "module": "nodenext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "nodenext"
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["node_modules", "./src/**/*.spec.ts"]
}